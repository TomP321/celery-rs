#!/usr/bin/env bash
# Run the compatibility harness; see tools/compat/celery_compat/cli.py.
# Wire commands clear and observe shared brokers, so acquire a lane lock.
run() {
  exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from celery_compat.cli import main; main()' "$(dirname "$(readlink -f "$0")")/tools/compat" "$@"
}
if [[ "${1:-}" == wire || "${1:-}" == wire-worker || "${1:-}" == wire-beat || "${1:-}" == cli ]]; then
  exec "$(dirname "$(readlink -f "$0")")/tools/dev/with-brokers" "$0" --locked "$@"
fi
[[ "${1:-}" == --locked ]] && shift
run "$@"
