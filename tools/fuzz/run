#!/usr/bin/env python3
"""Run each proptest target for at least 600 seconds with permanent logs."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[2]
os.chdir(ROOT)
output = ROOT / 'target/fuzz' / time.strftime('%Y%m%d-%H%M%S')
output.mkdir(parents=True)
env = dict(os.environ, CELERY_RS_FUZZ_SECONDS='600')
targets = [('celery-proto', 'fuzz_json'), ('celery-proto', 'fuzz_compression'),
           ('celery-transport', 'fuzz_redis_envelope'),
           ('celery-transport', 'fuzz_amqp_properties')]
subprocess.run(['cargo', 'test', '-p', 'celery-proto', '-p', 'celery-transport', '--no-run'], check=True)
jobs = []
for package, target in targets:
    log = (output / f'{target}.log').open('w')
    started = time.monotonic()
    process = subprocess.Popen(['cargo', 'test', '-p', package, target, '--', '--ignored', '--nocapture'],
                               env=env, stdout=log, stderr=subprocess.STDOUT)
    jobs.append((target, process, log, started))
rows = []
for target, process, log, started in jobs:
    code = process.wait()
    log.close()
    rows.append({'target': target, 'exit_code': code, 'seconds': time.monotonic() - started})
(output / 'results.json').write_text(json.dumps(rows, indent=2))
print(output)
sys.exit(int(any(row['exit_code'] for row in rows)))
