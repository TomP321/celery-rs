#!/usr/bin/env python3
"""Isolate Python state between files sharing a broker lane."""
import subprocess
import sys
from pathlib import Path


def main():
    directory = Path(sys.argv[1])
    failed = 0
    for file in sys.argv[2:]:
        result = subprocess.run(['.venv-rs/bin/python', '-m', 'pytest', file, '-q',
                                 f'--junitxml={directory}/{Path(file).stem}.xml'])
        failed += result.returncode != 0
    print(f'Group: {len(sys.argv) - 2} files, {failed} failed', flush=True)
    return bool(failed)


if __name__ == '__main__':
    sys.exit(main())
