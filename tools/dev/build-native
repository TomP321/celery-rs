#!/usr/bin/env bash
# Install only _celery_rs beside reference Celery (default: .venv-ref).
# Run maturin from the crate directory: the root pyproject would replace reference Celery.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
VENV="$(cd "${1:-$ROOT/.venv-ref}" && pwd)"
cd "$ROOT/crates/celery-py"
env -u CONDA_PREFIX VIRTUAL_ENV="$VENV" "$VENV/bin/maturin" develop --release
