#!/usr/bin/env bash
# Esegue una spec con DeepSeek in un worktree git isolato, per lavorare in parallelo.
#   tools/agent/ds-worktree specs/02b-transport-redis.md [messaggio di follow-up]
# Worktree: ../celery-rs-wt/<spec> sul branch agent/<spec>, con un proprio .venv-ref
# (maturin develop installa _celery_rs nel venv: con un venv condiviso due agenti si
# sovrascriverebbero il modulo a vicenda) e una propria cartella target/.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
SPEC="$1"; shift || true
NAME="$(basename "$SPEC" .md)"
WT="$(dirname "$ROOT")/celery-rs-wt/$NAME"

if [[ ! -d "$WT" ]]; then
  git -C "$ROOT" worktree add -q -b "agent/$NAME" "$WT" HEAD
  # sorgente di riferimento in sola lettura: un symlink basta
  ln -s "$ROOT/celery" "$WT/celery"
  uv venv -q -p "$ROOT/.venv-ref/bin/python" "$WT/.venv-ref"
  VIRTUAL_ENV="$WT/.venv-ref" uv pip install -q --no-deps -r "$ROOT/tools/compat/env-requirements.txt" maturin
  VIRTUAL_ENV="$WT/.venv-ref" uv pip install -q --no-deps -e "$ROOT/celery"
  # maturin rifiuta di partire con CONDA_PREFIX e VIRTUAL_ENV entrambi impostati
  mv "$WT/.venv-ref/bin/maturin" "$WT/.venv-ref/bin/maturin.real"
  printf '#!/bin/sh\nunset CONDA_PREFIX\nexec "$(dirname "$0")/maturin.real" "$@"\n' > "$WT/.venv-ref/bin/maturin"
  chmod +x "$WT/.venv-ref/bin/maturin"
fi

exec "$WT/tools/agent/ds" "$WT/specs/$NAME.md" "$@"
