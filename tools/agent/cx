#!/usr/bin/env bash
# Run a spec with Codex in the current repository or worktree.
# Pass a follow-up message to resume the saved session. Logs and thread IDs live in tools/agent/logs/.
# The owner disabled sandboxing because AppArmor blocks bubblewrap user namespaces.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
MODEL="${CX_MODEL:-gpt-6.1-sol}"
EFFORT="${CX_EFFORT:-low}"
SPEC="$1"; shift || true
NAME="$(basename "$SPEC" .md)"
LOGS="$ROOT/tools/agent/logs"; mkdir -p "$LOGS"
SESSION_FILE="$LOGS/$NAME.cx-session"

cd "$ROOT"
COMMON=(-m "$MODEL" -c "model_reasoning_effort=\"$EFFORT\"" --json --skip-git-repo-check
        --dangerously-bypass-approvals-and-sandbox)
if [[ $# -gt 0 ]]; then
  MSG="$*"
  if [[ -f "$SESSION_FILE" ]]; then
    CMD=(codex exec resume "${COMMON[@]}" "$(cat "$SESSION_FILE")" "$MSG")
  else
    CMD=(codex exec "${COMMON[@]}" -C "$ROOT" "$MSG")
  fi
else
  MSG="Implement the spec in $SPEC. Follow AGENTS.md. Work until the acceptance criteria are met and verified by running the specified commands."
  CMD=(codex exec "${COMMON[@]}" -C "$ROOT" "$MSG")
fi

{ echo "=== $(date -Is) codex model=$MODEL effort=$EFFORT"; echo ">>> $MSG"; } >> "$LOGS/$NAME.log"
"${CMD[@]}" < /dev/null 2>> "$LOGS/$NAME.stderr" \
  | tee -a "$LOGS/$NAME.jsonl" \
  | python3 -I "$ROOT/tools/agent/cx_filter.py" "$SESSION_FILE" "$LOGS/$NAME.log"
echo "=== end $(date -Is)" >> "$LOGS/$NAME.log"
tail -40 "$LOGS/$NAME.log"
