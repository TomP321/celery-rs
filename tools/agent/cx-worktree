#!/usr/bin/env bash
# Run a spec with Codex in an isolated Git worktree.
# Each worktree has its own venvs and target directory to avoid overwriting native modules.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
SPEC="$1"; shift || true
NAME="$(basename "$SPEC" .md)"
WT="$(dirname "$ROOT")/celery-rs-wt/$NAME"

if [[ ! -d "$WT" ]]; then
  git -C "$ROOT" worktree add -q -b "agent/$NAME" "$WT" "${CX_BASE:-HEAD}"
  # A symlink suffices for the read-only reference source.
  ln -s "$ROOT/celery" "$WT/celery"
  uv venv -q -p "$ROOT/.venv-ref/bin/python" "$WT/.venv-ref"
  VIRTUAL_ENV="$WT/.venv-ref" uv pip install -q --no-deps -r "$ROOT/tools/compat/env-requirements.txt" maturin
  VIRTUAL_ENV="$WT/.venv-ref" uv pip install -q --no-deps -e "$ROOT/celery"
  uv venv -q -p "$ROOT/.venv-ref/bin/python" "$WT/.venv-rs"
  VIRTUAL_ENV="$WT/.venv-rs" uv pip install -q --no-deps -r "$ROOT/tools/compat/env-requirements.txt" maturin
  # maturin rejects simultaneous CONDA_PREFIX and VIRTUAL_ENV.
  mv "$WT/.venv-ref/bin/maturin" "$WT/.venv-ref/bin/maturin.real"
  printf '#!/bin/sh\nunset CONDA_PREFIX\nexec "$(dirname "$0")/maturin.real" "$@"\n' > "$WT/.venv-ref/bin/maturin"
  chmod +x "$WT/.venv-ref/bin/maturin"
fi

exec "$WT/tools/agent/cx" "$WT/specs/$NAME.md" "$@"
