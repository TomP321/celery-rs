#!/usr/bin/env bash
# Run a spec with DeepSeek v4.1 flash through opencode.
# Pass a follow-up message to resume the session saved in tools/agent/logs/.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
MODEL="${DS_MODEL:-opencode-go/deepseek-v4.1-flash}"
SPEC="$1"; shift || true
NAME="$(basename "$SPEC" .md)"
LOGS="$ROOT/tools/agent/logs"; mkdir -p "$LOGS"
SESSION_FILE="$LOGS/$NAME.session"

cd "$ROOT"
if [[ $# -gt 0 ]]; then
  [[ -f "$SESSION_FILE" ]] || { echo "no session for $NAME" >&2; exit 2; }
  MSG="$*"
  ARGS=(--session "$(cat "$SESSION_FILE")")
else
  MSG="Implement the spec in $SPEC. Follow AGENTS.md. Work until the acceptance criteria are met and verified by running the specified commands."
  ARGS=(--title "celery-rs $NAME")
fi

{ echo "=== $(date -Is) model=$MODEL"; echo ">>> $MSG"; } >> "$LOGS/$NAME.log"
# Close stdin: without a TTY, opencode reads it as part of the prompt and waits.
opencode run -m "$MODEL" --auto --format json "${ARGS[@]}" "$MSG" < /dev/null \
  | tee -a "$LOGS/$NAME.jsonl" \
  | python3 -I "$ROOT/tools/agent/filter.py" "$SESSION_FILE" "$LOGS/$NAME.log"
echo "=== end $(date -Is)" >> "$LOGS/$NAME.log"
tail -40 "$LOGS/$NAME.log"
